# ================================================================
# CAVERE - ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# ================================================================
# Mantenha este arquivo seguro e NUNCA compartilhe em repositórios públicos.
# O arquivo '.env' já está devidamente ignorado no .gitignore.

# 1. Chave Secreta da Aplicação (Criptografia de sessões, cookies e CSRF)
# Gere uma chave forte no terminal com: python -c "import secrets; print(secrets.token_hex(32))"
# Se deixado em branco, o Cavere gerará uma chave segura local automática no arquivo .secret_key
SECRET_KEY=

# 2. Modo de Desenvolvimento (1 = Ativado com auto-reload / 0 = Produção seguro)
# ATENÇÃO: Deixe como 0 quando for colocar em produção!
FLASK_DEBUG=0

# 3. Host e Porta do Servidor (Opcional)
HOST=127.0.0.1
PORT=5000

# 4. Segurança de Cookies em Produção com HTTPS (1 = Ativado / 0 = Desativado)
# Ative apenas se o seu sistema for acessado via HTTPS com certificado SSL
SESSION_COOKIE_SECURE=0
